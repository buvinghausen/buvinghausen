// .devcontainer/devcontainer.json
{
  "name": "buvinghausen",

  // Compose, purely to add the sibling-repo bind mount (see docker-compose.yml's
  // volumes comment) -- same reason Bifrost uses compose.
  "dockerComposeFile": "docker-compose.yml",
  "service": "buvinghausen",
  // Nested one level inside the mounted src/buvinghausen folder (see
  // docker-compose.yml's volumes comment) -- VS Code/terminal cwd and Claude
  // Code's project-root resolution both follow this, so every session still
  // lands in this repo and still picks up its CLAUDE.md/.claude/settings.json
  // automatically, while CSnakes, SequentialGuid, TaskTupleAwaiter, efcore,
  // efcore.pg, grpc-dotnet, and protobuf-net now actually resolve as siblings.
  "workspaceFolder": "/workspaces/buvinghausen/buvinghausen",

  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {},
    "ghcr.io/dirien/devcontainer-feature-codex/codex:0": {},
    // Reuses the host's own Docker Desktop/WSL2 engine via its socket instead of
    // running a second, nested daemon -- Testcontainers only needs a reachable
    // Docker API, it doesn't care whose engine answers it. Lighter than Bifrost's
    // docker-in-docker (no nested dind-var-lib-docker volume, no daemon startup
    // cost). moby:false takes Docker CE for the same reason as Bifrost: no
    // guaranteed moby-* packages on every base/arch combination.
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:2": {
      "version": "24",
      "npmVersion": "12"
    },
    // "lts" tracks TOOLCHAIN.md's own `--channel LTS` convention -- not pinned
    // to a preview build the way Bifrost pins to 11.0 preview for Norse's DU
    // work, which doesn't apply here. dotnetRuntimeVersions installs the two
    // older shared runtimes multi-targeted OSS libraries (SequentialGuid,
    // TaskTupleAwaiter) actually test against -- see TOOLCHAIN.md's "Older .NET
    // Runtimes" section. net472/net462 legs can't run through dotnet test's
    // launcher at all on Linux; Mono (Dockerfile) handles those directly.
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "lts",
      "dotnetRuntimeVersions": "9.0,8.0"
    },
    // enableShared: CSnakes embeds the interpreter in-process and needs
    // libpython3.x.so, not just the python3 binary on PATH -- the feature's
    // default build doesn't produce one.
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.14",
      "enableShared": true
    }
  },

  // The home volume is declared external in docker-compose.yml, and compose
  // refuses to create external volumes itself. Idempotent -- `docker volume
  // create` on an existing volume just prints its name. Runs on the host,
  // before the build. Durable across rebuilds: nuget/npm caches and every
  // CLI's own auth state (gh, claude, codex) all live under here instead of
  // re-authenticating on every "Rebuild Container".
  "initializeCommand": {
    "home-volume": "docker volume create buvinghausen-home"
  },

  // SSH agent forwarding needs no config here -- VS Code auto-forwards whatever
  // agent is running on the host (Bitwarden's bridge on WSL2/Fedora, the native
  // agent on Windows) into SSH_AUTH_SOCK, same as Bifrost. configure-git-ssh-signing.sh
  // points git's signing at whatever key that forwarded agent is holding.
  "remoteEnv": {
    // Set on the host before the container starts; configure-git-ssh-signing.sh
    // applies these and derives the signing key from whatever the forwarded
    // agent is holding. Unset means the script skips both steps.
    "GIT_USER_NAME": "${localEnv:GIT_USER_NAME}",
    "GIT_USER_EMAIL": "${localEnv:GIT_USER_EMAIL}",
    "NUGET_PACKAGES": "/home/vscode/.nuget/packages",
    // inotify doesn't cross a Windows-side bind mount; anything watching must poll.
    "DOTNET_USE_POLLING_FILE_WATCHER": "1",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
  },

  "postCreateCommand": {
    // ${containerWorkspaceFolder} covers this repo; the siblings mounted alongside
    // it (see docker-compose.yml's volumes comment) land root-owned through that
    // same mount, so they hit the same dubious-ownership check. Scanning the
    // parent mount's immediate children for a .git directory picks up whatever
    // siblings are actually checked out on the next rebuild without editing this
    // line by hand -- same self-maintaining idea as Bifrost's submodule foreach.
    "safe-directory": "git config --global --add safe.directory ${containerWorkspaceFolder} && for d in /workspaces/buvinghausen/*/; do [ -d \"$d/.git\" ] && git config --global --add safe.directory \"${d%/}\"; done",
    "git-ssh-signing": "bash ${containerWorkspaceFolder}/.devcontainer/configure-git-ssh-signing.sh",
    "posh-git-sh": "bash ${containerWorkspaceFolder}/.devcontainer/configure-posh-git-sh.sh",
    // npm 12 blocks lifecycle scripts unless the package is named in
    // allow-scripts, so the claude-code feature's `npm install -g` silently
    // skips the postinstall that places the native binary -- `claude` then
    // exits with "native binary not installed". This runs that postinstall
    // directly. Drop it if the feature turns npm-12-aware, or npm gets pinned
    // back to 11.
    "claude-native-binary": "sudo \"$(command -v node)\" \"$(npm root -g)/@anthropic-ai/claude-code/install.cjs\"",
    // The dirien codex feature installs @openai/codex globally during image
    // build, as root -- everything else under lib/node_modules is vscode:nvm
    // (group-writable), but @openai/codex itself lands root:nvm, so
    // `npm install -g @openai/codex` as vscode (e.g. to self-update) fails
    // renaming the old dir out of the way: EACCES.
    "codex-ownership": "sudo chown -R vscode:nvm \"$(npm root -g)\""
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-dotnettools.csdevkit", "ms-python.python"],
      "settings": {
        // Point the .NET Install Tool at the container's own install so
        // csharp/csdevkit stop acquiring private runtimes under ~/.vscode-server.
        "dotnetAcquisitionExtension.sharedExistingDotnetPath": "/usr/share/dotnet/dotnet",
        "python.defaultInterpreterPath": "/usr/local/python/current/bin/python"
      }
    }
  }
}
