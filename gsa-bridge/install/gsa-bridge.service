[Unit]
Description=gsa-bridge (WSL half) - relays GSA-protected Azure endpoints from WSL to Windows
Documentation=file:///mnt/c/Users/buvy/gsa-bridge/spec.md
After=network.target gsa-bridge-hosts.service
# The hosts block must be in place before clients can resolve the bridged names.
Requires=gsa-bridge-hosts.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /mnt/c/Users/buvy/gsa-bridge/wsl/gsa_bridge.py
Restart=on-failure
RestartSec=5

# Ports 443 and 1433 are privileged. Grant just the one capability rather than
# running the relay as root.
User=buvy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=true

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
